# ==============================================================================
# ODIINS PLATFORM - HOSTINGER PRODUCTION CONFIGURATION (.htaccess)
# ==============================================================================

# 1. Enable URL Rewriting for Clean URLs (e.g. /contact -> /contact.html)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Permanent Redirects for Legacy Google-Indexed URLs
  RewriteRule ^staffing-services-bhubaneswar(\.html)?/?$ /services-employers [R=301,L]
  RewriteRule ^staffing-services-in-bhubaneswar(\.html)?/?$ /services-employers [R=301,L]
  RewriteRule ^staffing-solutions(-in)?-bhubaneswar(\.html)?/?$ /services-employers [R=301,L]

  # Clean URLs: serve .html files if path matches without extension
  RewriteRule ^staffing-and-manpower-solutions-in-bhubaneswar/?$ staffing-and-manpower-solutions-in-bhubaneswar.html [L]
  RewriteRule ^bank-csp/?$ bank-csp-odisha.html [L]
  RewriteRule ^csp/?$ bank-csp-odisha.html [L]
  RewriteRule ^how-to-hire-sales-managers-manpower-in-bhubaneswar/?$ how-to-hire-sales-managers-manpower-in-bhubaneswar.html [L]
  RewriteRule ^top-in-demand-private-jobs-in-bhubaneswar-odisha/?$ top-in-demand-private-jobs-in-bhubaneswar-odisha.html [L]
  RewriteRule ^guide-to-hiring-verified-maids-cooks-tutors-bhubaneswar/?$ guide-to-hiring-verified-maids-cooks-tutors-bhubaneswar.html [L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Custom 404 Error Handler
ErrorDocument 404 /404.html

# Correct MIME Types (Critical for Google Search Console XML Sitemap fetching)
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/xml .xml
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
</IfModule>

# 2. Browser Caching (Leverage Browser Cache for 98-100 PageSpeed Scores)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Icons
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"

  # CSS & JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # HTML
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# 3. Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# 4. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Prevent directory listing
Options -Indexes
