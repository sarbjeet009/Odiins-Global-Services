# ==============================================================================
# ODIINS PLATFORM - HOSTINGER PRODUCTION CONFIGURATION (.htaccess)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Force www.odiins.in (Canonical Host to prevent duplicate non-www indexation)
  RewriteCond %{HTTP_HOST} ^odiins\.in$ [NC]
  RewriteRule ^(.*)$ https://www.odiins.in/$1 [L,R=301]

  # 3. 301 Redirect index.html to Root
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html [NC]
  RewriteRule ^index\.html$ https://www.odiins.in/ [R=301,L]

  # 4. 301 Permanent Redirects for Legacy / Placeholder URLs
  RewriteRule ^staffing-services-bhubaneswar(\.html)?/?$ /services-employers [R=301,L]
  RewriteRule ^staffing-services-in-bhubaneswar(\.html)?/?$ /services-employers [R=301,L]
  RewriteRule ^staffing-solutions(-in)?-bhubaneswar(\.html)?/?$ /services-employers [R=301,L]
  RewriteRule ^blog-detail(\.html)?/?$ /blogs [R=301,L]

  # 5. 301 Redirect direct .html requests to clean URLs (prevents duplicate .html content)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html(\?[^\ ]*)?\ HTTP/ [NC]
  RewriteCond %{REQUEST_URI} !^/404\.html$
  RewriteRule ^([^.]+)\.html$ https://www.odiins.in/$1 [R=301,L]

  # 6. Specific Aliases / Clean Rewrites
  RewriteRule ^bank-csp/?$ bank-csp-odisha.html [L]
  RewriteRule ^csp/?$ bank-csp-odisha.html [L]

  # 7. Internal Rewrite: Serve file.html if path exists without extension
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Custom 404 Error Handler
ErrorDocument 404 /404.html

# Correct MIME Types (Critical for Google Search Console XML Sitemap fetching)
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/xml .xml
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
</IfModule>

# Browser Caching (Leverage Browser Cache for 98-100 PageSpeed Scores)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Icons
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"

  # CSS & JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # HTML
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Prevent directory listing
Options -Indexes
